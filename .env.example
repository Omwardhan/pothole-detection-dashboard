# ==============================================================================
# AI-BASED POTHOLE DETECTION SYSTEM - DASHBOARD CONFIGURATION
# ==============================================================================

# DATA SOURCE MODE
# Set to 'false' to connect to real Cloud Firestore database via Firebase Web SDK (Primary).
# Set to 'true' to use local mock data (mockDetections.js) for offline testing/development.
VITE_USE_MOCK_DATA=false

# RASPBERRY PI LIVE VIDEO STREAM URL
# Local MJPEG stream from Flask server on the Raspberry Pi 4 (Port 5000).
# Must be accessible on the local network (same Wi-Fi / hotspot).
VITE_PI_VIDEO_URL=your_pi_video_url_here

# FIREBASE WEB SDK CONFIGURATION
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app.
# NOTE: The Firebase service account key (firebase-key.json) is used ONLY on the Raspberry Pi.
# NEVER put the service account JSON key in the frontend.
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
